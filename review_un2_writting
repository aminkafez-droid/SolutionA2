select,textarea,input[type=text]{font:inherit;border:2px solid #3E2723;border-radius:8px;padding:3px 6px;background:#fff;color:#3E2723;max-width:100%}
textarea{width:100%;box-sizing:border-box;min-height:64px}
select.ok{background:#BAD797}select.bad{background:#F4C9D6}
.s{display:none}.s.on{display:block}
.poster{display:grid;place-items:center;min-height:170px;border:3px dashed var(--acc);border-radius:12px;text-align:center;cursor:pointer;overflow:hidden;padding:8px}
