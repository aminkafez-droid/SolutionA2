mark{color:#3E2723;border-radius:4px;padding:0 3px}.t1{background:#BAD797}.t2{background:#F4C9D6}.m{background:#FFEDAC;outline:2px solid #5D0703}.l{background:transparent;color:inherit;border-bottom:3px solid var(--acc);border-radius:0}
</style></head><body><main>
<div><span class="tag">🎬 Unit 3 · On screen</span><span class="tag">⚛️ E = mc²</span><span class="tag">🍿 Movie night</span></div>
<h1>Reviewing Project Hail Mary</h1>
<p>Today I can write a short film review and recommend a film.</p>
<nav id="nav"></nav><div id="app"></div></main>
<script>const POS={"phm": "data:image/jpeg;base64,", "tw": "data:image/jpeg;base64,", "hg": "data:image/jpeg;base64,"},STK={"ticket": "data:image/webp;base64,", "clap": "data:image/webp;base64,", "popcorn": "data:image/webp;base64,", "reel": "data:image/webp;base64,", "movienight": "data:image/webp;base64,", "star": "data:image/webp;base64,", "masks": "data:image/webp;base64,", "marquee": "data:image/webp;base64,", "gstars": "data:image/webp;base64,", "atom": "data:image/webp;base64,", "moon": "data:image/webp;base64,", "cat": "data:image/webp;base64,", "pi": "data:image/webp;base64,", "blackhole": "data:image/webp;base64,", "proton": "data:image/webp;base64,", "newton": "data:image/webp;base64,", "galaxy": "data:image/webp;base64,"};</script>
<script>
const F=["Title and type of film","What happens (plot)","My opinion","Recommendation","Rating"];
const T=(id,t,ins,items)=>{let h=`<div class="card" id="${id}"><h3>${t}</h3><p><i>${ins}</i></p>`;
items.forEach((it,i)=>{h+=`<p>${i+1}. ${it[0]} <select data-a="${it[2]}"><option value="">…</option>${it[1].map(o=>`<option>${o}</option>`).join("")}</select> ${it[3]||""}</p>`});
return h+`<button onclick="chk('${id}')">Check</button><button onclick="ans('${id}')">Show answers</button> <b class="sc"></b></div>`};
const chk=id=>{const c=document.getElementById(id),s=[...c.querySelectorAll("select")];let n=0;
s.forEach(e=>{const k=e.value===e.dataset.a;if(k)n++;e.className=k?"ok":"bad"});c.querySelector(".sc").textContent=n+" / "+s.length+(n==s.length?" ⭐ Great!":"")};
const ans=id=>{const c=document.getElementById(id);c.querySelectorAll("select").forEach(e=>{e.value=e.dataset.a;e.className="ok"});c.querySelector(".sc").textContent="Answers shown"};
const ld=i=>{const f=i.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{i.parentNode.innerHTML='<img alt="poster" src="'+r.result+'">'};r.readAsDataURL(f)};
const P=(t,k)=>`<figure class="fig"><img src="${POS[k]}" alt="${t}"><figcaption>${t}</figcaption></figure>`;
const pick=b=>{b.parentNode.querySelectorAll("button").forEach(x=>x.classList.remove("on"));b.classList.add("on")};
const cards=["Your friend wants to tell you the ending of a film. What do you say? (You mustn’t…)","Invite a friend to see an anime film this weekend. Suggest a day. (Would you like to… / How about…)","You are an astronaut. You wake up alone on a spaceship. What do you see? What must you do first?","Your friend says all science fiction films are unrealistic. Do you agree? Why / why not?","You have two cinema tickets. Your friend says, “Sorry, I can’t.” Suggest a different plan.","A new student has never seen an anime. Recommend one. Why must they see it?"];
let ci=0;const flip=()=>{document.getElementById("fc").innerHTML="🃏 "+cards[ci++%cards.length]};
const chkW=()=>{const t=[...document.querySelectorAll(".w")].map(x=>x.value).join(" "),n=(t.match(/\S+/g)||[]).length;
const R=[[n>=60,"60+ words ("+n+")"],[/\b(must|mustn[’']t|needn[’']t|don[’']t have to|have to)\b/i.test(t),"a modal: must / mustn’t / needn’t / don’t have to"],[/(a lot of|a few|a little|not many|not much|aren[’']t many|isn[’']t much)/i.test(t),"a quantity phrase"],[/(unrealistic|unbelievable|impossible|unlikely|incorrect|unfair|dishonest|illegal|improbable|uninteresting|unexciting)/i.test(t),"a negative adjective"],[/(gripping|spectacular|imaginative|moving|convincing|exciting|boring|confusing|violent|scary)/i.test(t),"a film adjective"],[/(plot|acting|characters|soundtrack|special effects|script|ending|scenes)/i.test(t),"an aspect of the film"]];
document.getElementById("wr").innerHTML=R.map(r=>(r[0]?"✅ ":"⬜ ")+r[1]).join("<br>")};
const TK=`<h3 style="margin-top:18px">Step 4 · Review toolkit</h3>
<div class="card"><b>Which tense?</b><p><mark class="t1">Present simple</mark> for the plot and your opinions: <q>A girl volunteers… The film is gripping.</q></p><p><mark class="t2">Past simple</mark> for what you did: <q>I watched it last weekend. I found it moving.</q></p></div>
<div class="card"><b>Linking words</b><p><mark class="l">and</mark> adds an idea · <mark class="l">but / however</mark> shows a contrast · <mark class="l">because</mark> gives a reason · <mark class="l">so</mark> gives a result · <mark class="l">also</mark> adds a point</p><p><q>The plot is imaginative, but the science is a little unrealistic.</q></p></div>`
+T("k1","Choose the tense","Plot and opinion: present simple. What you did: past simple.",[["In the film, a girl","volunteers|volunteered".split("|"),"volunteers","to take her sister’s place."],["I","watch|watched".split("|"),"watched","the trailer yesterday."],["Katniss","uses|used".split("|"),"uses","a bow and arrows in the film."]])
+T("k2","Choose the linking word","Contrast, reason, result or extra point?",[["The plot is imaginative,","but|because|so".split("|"),"but","some of the science is unrealistic."],["I loved the film","because|but|so".split("|"),"because","the special effects were spectacular."],["The ending was really moving,","so|but|because".split("|"),"so","I almost cried."],["The acting is convincing.","Also,|Because|So".split("|"),"Also,","the soundtrack is great."]])
+`<div class="box n"><b>My review template (homework)</b><br>1 Title – type of film<br>2 <mark class="t1">present simple</mark>: It’s a (adjective) film about…<br>3 The (aspect) was / were (adjective), <mark class="l">but</mark> / <mark class="l">because</mark>… There are a lot of… <mark class="l">However,</mark> there aren’t many…<br>4 You <mark class="m">must</mark>… / You <mark class="m">mustn’t</mark>… / You <mark class="m">needn’t</mark>…<br>5 ★★★★☆</div>`;
const S=[
`<h2>1 · Warm-up</h2>${P("Project Hail Mary","phm")}
<div class="card"><b>Have you seen it?</b><br><button onclick="pick(this)">Yes, I have</button><button onclick="pick(this)">Not yet, but I want to</button><button onclick="pick(this)">Not my type</button></div>
<details class="card"><summary>🌌 Physics question</summary><p>Could people really travel to another star? Why / why not?</p></details>
<details class="card"><summary>🎌 Anime question</summary><p>What anime film or series did you watch recently? Describe it in three words.</p></details>`,
`<h2>2 · Vocabulary</h2>`+
T("v1","Film types","Choose the correct word.",[["A film about the future, space and robots is a","science fiction film|western|war film".split("|"),"science fiction film"],["A scary film with monsters is a","horror film|musical|romantic comedy".split("|"),"horror film"],["Anime and cartoons are","animation|news bulletins|documentaries".split("|"),"animation"],["A show where people sing and dance for judges is a","talent show|game show|chat show".split("|"),"talent show"]])+
T("v2","Aspects of films","Complete the sentences.",[["The _____ were spectacular: the spaceship looked real.","special effects|script|characters".split("|"),"special effects"],["I didn’t understand the _____. It was really confusing.","plot|soundtrack|acting".split("|"),"plot"],["The actors were convincing. The _____ was excellent.","acting|ending|scenes".split("|"),"acting"],["The music was great. I loved the _____.","soundtrack|script|plot".split("|"),"soundtrack"]])+
T("v3","Negative prefixes","Choose the opposite.",[["realistic →","unrealistic|inrealistic|irrealistic".split("|"),"unrealistic"],["believable →","unbelievable|imbelievable|disbelievable".split("|"),"unbelievable"],["possible →","unpossible|impossible|dispossible".split("|"),"impossible"],["likely →","unlikely|inlikely|illikely".split("|"),"unlikely"]]),
`<h2>3 · Grammar</h2><div class="box"><b>Learn this!</b><br>must = it’s necessary or very important · mustn’t = it’s prohibited · needn’t / don’t have to = it’s not necessary</div>`+
T("g1","must, mustn’t, needn’t / don’t have to","Choose the correct form.",[["You _____ spoil the ending! It’s not allowed in our film club.","mustn’t|needn’t".split("|"),"mustn’t"],["You _____ be a physicist to enjoy the film. It’s for everyone.","needn’t|mustn’t".split("|"),"needn’t"],["I think you _____ see this film! It’s amazing.","must|don’t have to".split("|"),"must"],["Tickets are free today, so you _____ pay.","don’t have to|mustn’t".split("|"),"don’t have to"],["You _____ use your phone in the cinema. It’s prohibited.","mustn’t|needn’t".split("|"),"mustn’t"]])+
T("g2","Quantity","Choose the correct phrase.",[["There are _____ spectacular scenes in the film.","a lot of|a little".split("|"),"a lot of"],["There aren’t _____ main characters, only a few.","many|much".split("|"),"many"],["There isn’t _____ violence, so it’s OK for teenagers.","much|many".split("|"),"much"],["I have _____ time before the film. Let’s get popcorn!","a little|a few".split("|"),"a little"],["Only _____ people were in the cinema, about five.","a few|a little".split("|"),"a few"]]),
`<h2>4 · Speaking</h2>${P("Twilight: describe the poster","tw")}
<p><i>Describe the poster: Who can you see? What is the mood? Would you watch this film? Why / why not?</i></p><div class="box n">I can see… · It looks like… · In the background there is… · I think he / she feels…</div>
<div class="card"><button onclick="flip()">🃏 Flip a situation card</button><p class="flip" id="fc">Press the button. Say what you would do.</p></div>
<div class="card"><b>30-second mini review</b><p>Say it aloud: the film’s name, what it is about, two opinions, one recommendation.</p></div>`,
`<h2>5 · Writing: film review</h2><div class="card"><h3>Model review</h3><p><b>Project Hail Mary – science fiction film</b></p><p>Project Hail Mary <mark class="t1">is</mark> a gripping science fiction film about a man who <mark class="t1">wakes up</mark> alone on a spaceship <mark class="l">and</mark> <mark class="m">must save</mark> the Earth.</p><p>The plot <mark class="t1">is</mark> imaginative, <mark class="l">and</mark> there <mark class="t1">are</mark> a lot of surprising scenes, <mark class="l">but</mark> there <mark class="t1">aren’t</mark> many characters. The special effects <mark class="t1">are</mark> spectacular <mark class="l">and</mark> the acting <mark class="t1">is</mark> convincing. A little of the science <mark class="t1">is</mark> unrealistic, <mark class="l">but</mark> I <mark class="t2">found</mark> the ending really moving.</p><p>You <mark class="m">mustn’t</mark> read spoilers before you watch it, <mark class="l">and</mark> you <mark class="m">needn’t</mark> be a physics expert to enjoy it. I think everyone <mark class="m">must</mark> see it!</p><div class="box"><mark class="t1">present simple</mark> = story and opinion · <mark class="t2">past simple</mark> = what you did · <mark class="m">modals</mark> = advice · <mark class="l">linking words</mark></div><p>★★★★☆</p></div>`+
T("w1","Step 1 · Analyse","What does each part of the model do?",[["<q>Project Hail Mary – science fiction film</q>",F,F[0]],["<q>…a man who wakes up alone on a spaceship and must save the Earth.</q>",F,F[1]],["<q>The special effects are spectacular and the acting is convincing.</q>",F,F[2]],["<q>You mustn’t read spoilers… I think everyone must see it!</q>",F,F[3]],["<q>★★★★☆</q>",F,F[4]]])+
T("w2","Step 1 · Find the language","What kind of language is it?",[["<q>a lot of surprising scenes</q>","quantity phrase|modal verb|aspect of film|negative adjective".split("|"),"quantity phrase"],["<q>you needn’t be a physics expert</q>","quantity phrase|modal verb|aspect of film|negative adjective".split("|"),"modal verb"],["<q>unrealistic</q>","quantity phrase|modal verb|aspect of film|negative adjective".split("|"),"negative adjective"],["<q>special effects</q>","quantity phrase|modal verb|aspect of film|negative adjective".split("|"),"aspect of film"]])+
T("w3","Step 2 · Build the template","Match each phrase to a part of the review.",[["<q>It’s a (adjective) film about…</q>",F,F[1]],["<q>The (aspect) was / were (adjective).</q>",F,F[2]],["<q>You must see it! / You needn’t… / You mustn’t…</q>",F,F[3]],["<q>Title – type of film</q>",F,F[0]],["<q>★ out of 5</q>",F,F[4]]])+
`<div class="box"><b>Our template</b><br>1 Title – type of film<br>2 It’s a (adjective) film about…<br>3 The (aspect) was / were (adjective). There are a lot of / aren’t many…<br>4 You must… / You mustn’t… / You needn’t…<br>5 ★★★★☆</div>
<div class="card"><h3>Step 3 · Draft together: The Hunger Games</h3>${P("The Hunger Games: Catching Fire (the sequel)","hg")}
<details><summary>💡 Hint 1: the world</summary><p>Panem is a country of the future. Every year, teenagers from twelve districts must take part in the Games.</p></details>
<details><summary>💡 Hint 2: the heroine</summary><p>Katniss Everdeen is sixteen. She volunteers to take her little sister’s place.</p></details>
<details><summary>💡 Hint 3: the Games</summary><p>The teenagers must survive in a big arena, and everybody watches on TV.</p></details>
<details><summary>💡 Opinion helper</summary><p>Aspects: plot, acting, characters, soundtrack, special effects, scenes.<br>Adjectives: gripping, spectacular, imaginative, moving, violent, unrealistic.</p></details>
<details><summary>🎞️ I haven’t seen it</summary><p>Look at the poster and imagine the film. Write what you think: “I think the acting is probably…”. You can also write about a film you know.</p></details>
<p><b>1 Title</b><textarea class="w" placeholder="The Hunger Games – … film"></textarea></p>
<p><b>2 Plot</b><textarea class="w" placeholder="The Hunger Games is a … film about…"></textarea></p>
<p><b>3 Opinion</b><textarea class="w" placeholder="The … was / were … There are a lot of … but there aren’t many…"></textarea></p>
<p><b>4 Recommendation</b><textarea class="w" placeholder="You must… You needn’t… You mustn’t…"></textarea></p>
<p><b>5 Rating</b><textarea class="w" placeholder="★★★★☆"></textarea></p>
<button onclick="chkW()">Check</button><button onclick="document.getElementById('sm').hidden=false">Show answers</button>
<p id="wr"></p><div class="box" id="sm" hidden><b>Sample</b><br>The Hunger Games – science fiction film. The Hunger Games is a gripping film about a girl who volunteers to take her sister’s place in a deadly TV competition. The plot is exciting and the acting is convincing, but some scenes are violent and the future world is a little unrealistic. There aren’t many funny moments, but there are a lot of tense scenes. You mustn’t miss the ending, and you needn’t read the books first. ★★★★☆</div></div>`+TK,
`<h2>6 · Reflection</h2><div class="card"><b>Today I can…</b><br><label><input type="checkbox"> talk about films and TV programmes</label><br><label><input type="checkbox"> use must, mustn’t and needn’t</label><br><label><input type="checkbox"> use a lot of, many, much, a few, a little</label><br><label><input type="checkbox"> write a film review with a template</label></div>
<div class="card"><b>Three phrases I will use this week</b><p><input type="text" placeholder="Phrase 1"> <input type="text" placeholder="Phrase 2"> <input type="text" placeholder="Phrase 3"></p></div>
<div class="card"><b>The lesson was…</b><br><button onclick="pick(this)">🙁</button><button onclick="pick(this)">😐</button><button onclick="pick(this)">🙂</button><button onclick="pick(this)">🤩</button></div>
<div class="box n"><b>Homework</b><br>Write your own review (60–80 words) of a film or an anime you know. Use our template.</div>`];
document.getElementById("app").innerHTML=S.map((h,i)=>`<section class="s${i?"":" on"}" id="s${i}">${h}</section>`).join("");
const N=["Warm-up","Vocabulary","Grammar","Speaking","Writing","Reflection"];
const go=i=>{document.querySelectorAll(".s").forEach((s,k)=>s.classList.toggle("on",k==i));document.querySelectorAll("nav button").forEach((b,k)=>b.classList.toggle("on",k==i));window.scrollTo(0,0)};
document.getElementById("nav").innerHTML=N.map((n,i)=>`<button onclick="go(${i})">${i+1} ${n}</button>`).join("");go(0);
const DK=[["clap","popcorn","star"],["ticket","atom","masks","reel"],["blackhole","cat","gstars"],["marquee","moon","newton"],["pi","proton","movienight","star"],["galaxy","popcorn","clap"]];
document.querySelectorAll(".s").forEach((s,i)=>{const cs=[...s.querySelectorAll(".card,.box")].filter(c=>c.tagName!="DETAILS");DK[i].forEach((k,j)=>{const c=cs[Math.floor(j*cs.length/DK[i].length)];if(!c)return;const m=document.createElement("img");m.className="st";m.src=STK[k];m.alt="";m.style.top=(-26+(j%2)*4)+"px";m.style[j%2?"left":"right"]=(8+j*6)+"px";m.style.transform="rotate("+((j%2?-1:1)*(7+j*3))+"deg)";c.appendChild(m)})});
[["cat","right:8px;top:70px;transform:rotate(8deg)"],["star","right:96px;top:6px;transform:rotate(-12deg)"]].forEach(a=>{const m=document.createElement("img");m.className="st";m.src=STK[a[0]];m.alt="";m.style.cssText=a[1];document.querySelector("main").appendChild(m)});
</script></body></html>
