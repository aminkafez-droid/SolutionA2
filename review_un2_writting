<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Reviewing Project Hail Mary</title>
<link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Raleway:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#FFEDAC;--ink:#3E2723;--card:#fff8dc;--acc:#5D0703;--g:#BAD797;--p:#F4C9D6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#282B4A;--ink:#FFEDAC;--card:#33375c;--acc:#F4C9D6}}
:root[data-theme="dark"]{--bg:#282B4A;--ink:#FFEDAC;--card:#33375c;--acc:#F4C9D6}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 Raleway,system-ui,sans-serif}
main{max-width:760px;margin:0 auto;padding:14px}
h1,h2,h3{font-family:'Abril Fatface',Georgia,serif;font-weight:400;color:var(--acc);margin:.2em 0}
h1{font-size:2.3rem;line-height:1.05;transform:rotate(-1.5deg)}
.tag{display:inline-block;background:var(--p);color:#3E2723;border:2px solid #3E2723;border-radius:8px;padding:2px 10px;font-weight:800;margin:2px;transform:rotate(1.5deg)}
.card{background:var(--card);border:2px solid var(--ink);border-radius:14px;padding:12px 14px;margin:12px 0;box-shadow:4px 4px 0 var(--acc)}
nav{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
button{font:inherit;font-weight:600;border:2px solid #3E2723;background:var(--g);color:#3E2723;border-radius:999px;padding:5px 14px;cursor:pointer;margin:2px}
