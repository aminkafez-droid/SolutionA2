.card,.box,.fig{position:relative}main{position:relative}
.fig{margin:12px 0;text-align:center}.fig img:not(.st){max-width:70%;max-height:380px;border-radius:12px;border:3px solid var(--ink);box-shadow:5px 5px 0 var(--acc)}
